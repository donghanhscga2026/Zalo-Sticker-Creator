# Cloudflare Workers AI: used for free-tier sticker image generation.
# Add these values in AI Studio > Secrets. Never commit real tokens.
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"

# Optional: keep Gemini key only if other app features need Gemini text models.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: injected by AI Studio / hosting environment when applicable.
APP_URL="MY_APP_URL"
